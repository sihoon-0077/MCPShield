# Required: use distinct random secrets of at least 16 characters.
ADMIN_API_TOKEN=
SCANNER_API_TOKEN=
CORS_ALLOWLIST=
DATABASE_PATH=
API_HOST=
API_PORT=
MCPSHIELD_JUDGE_DEMO_ENABLED=false
OPERATION_LEASE_MS=
VALIDATOR_ADDRESSES=
ATTESTATION_CHAIN_ID=
ATTESTATION_CONTRACT=

# Enable EVM mode by setting all three. Never commit real keys.
RPC_URL=
REGISTRY_ADDRESS=
RELAYER_PRIVATE_KEY=
RPC_TIMEOUT_MS=

# Additive authenticated /v1 control plane (disabled by default).
CONTROL_PLANE_ENABLED=false
CONTROL_PLANE_CREDENTIALS=
CONTROL_DATABASE_URL=
CONTROL_ARTIFACT_PATH=
CONTROL_EVIDENCE_PATH=
CONTROL_EVIDENCE_KEY=
CONTROL_S3_BUCKET=
CONTROL_S3_REGION=
CONTROL_S3_ENDPOINT=
CONTROL_S3_KMS_KEY_ID=
CONTROL_S3_ALLOW_LOOPBACK_HTTP=false
CONTROL_SIGNING_KEY=
CONTROL_SIGNING_KEY_ID=
CONTROL_V2_RPC_URLS=
CONTROL_V2_CHAIN_ID=
CONTROL_V2_REGISTRY_ADDRESS=
CONTROL_V2_CONFIRMATIONS=2
# Default is static-only; docker requires a separate trusted Linux worker host.
CONTROL_SANDBOX_MODE=

# Gateway signed trust context; credentials never belong in NEXT_PUBLIC_*.
MCPSHIELD_TENANT_ID=
MCPSHIELD_CONTROL_TOKEN=
MCPSHIELD_CONTROL_RELEASE_ID=
MCPSHIELD_POLICY_HASH=
MCPSHIELD_CACHE_PUBLIC_KEY=
MCPSHIELD_CACHE_KEY_ID=
MCPSHIELD_CHAIN_ID=
MCPSHIELD_REGISTRY_CONTRACT=
MCPSHIELD_VALIDATOR_SET_VERSION=
MCPSHIELD_ADMISSION_MODE=strict
MCPSHIELD_ADMISSION_CACHE_FILE=

MCPSHIELD_TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=mcpshield
OTEL_EXPORTER_OTLP_ENDPOINT=
MCPSHIELD_OTEL_ALLOW_HTTP=false
