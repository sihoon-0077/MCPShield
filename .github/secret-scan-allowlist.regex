# Deterministic public Ganache development key, only in root Compose.
^docker-compose\.yml:[0-9]+:.*0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80.*$
# Deterministic public Ganache mnemonic, only in root Compose and the demo seeder.
^(docker-compose\.yml|scripts/demo/seed\.mjs):[0-9]+:.*test test test test test test test test test test test junk.*$
# Deliberately fake AWS-shaped token used by the scanner redaction test.
^tests/security/scanner\.test\.mjs:[0-9]+:.*AKIA1234567890ABCDEF.*$
