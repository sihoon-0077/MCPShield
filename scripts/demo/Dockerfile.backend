FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=development
COPY package.json package-lock.json tsconfig.json ./
COPY apps/api ./apps/api
COPY apps/indexer ./apps/indexer
COPY apps/reconciler ./apps/reconciler
COPY apps/validator ./apps/validator
COPY contracts ./contracts
COPY database ./database
COPY packages/contracts-sdk ./packages/contracts-sdk
COPY packages/protocol ./packages/protocol
COPY services/scanner ./services/scanner
COPY services/exfil-sink ./services/exfil-sink
COPY demo/fixtures ./demo/fixtures
COPY scripts/demo/package.json ./scripts/demo/package.json
COPY scripts/demo/seed.mjs ./scripts/demo/seed.mjs
COPY apps/dashboard/package.json ./apps/dashboard/package.json
COPY apps/gateway/package.json ./apps/gateway/package.json
RUN npm ci --ignore-scripts && npm cache clean --force
USER node
CMD ["npm", "run", "start:api"]
