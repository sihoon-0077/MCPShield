{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpshield.dev/schemas/admission-request.schema.json",
  "title": "MCPShield Admission Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "artifactDigest", "toolSurfaceHash"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "releaseId": { "type": "string", "minLength": 5, "maxLength": 214 },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "toolSurfaceHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  }
}
