{
  "uid": "mcpshield-operations",
  "title": "MCPShield · 측정된 운영 상태",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "mcpshield",
    "measured"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "지표를 읽기 전에",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "실제로 수집된 지표만 표시합니다. **No data는 0건이나 정상 운영을 뜻하지 않습니다.** LIVE·CACHE·REPLAY를 구분하며, 목표 수치는 달성 결과가 아닙니다. 원문 도구 호출·메일·비밀값은 수집하지 않습니다."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "실시간 허용·차단 / 초",
      "datasource": {
        "type": "prometheus",
        "uid": "mcpshield-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (rate(mcpshield_admission_decisions_total{source=\"LIVE\"}[5m]))",
          "legendFormat": "{{decision}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "실시간 판단 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "mcpshield-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcpshield_admission_latency_seconds_bucket{source=\"LIVE\"}[5m])))",
          "legendFormat": "LIVE p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "읽기 전용 캐시 판단 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "mcpshield-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcpshield_admission_latency_seconds_bucket{source=\"CACHE\"}[5m])))",
          "legendFormat": "CACHE p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "단계별 오류 / 5분",
      "datasource": {
        "type": "prometheus",
        "uid": "mcpshield-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (increase(mcpshield_scan_stages_total{result=\"error\"}[5m]))",
          "legendFormat": "{{stage}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "단계별 처리 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "mcpshield-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(mcpshield_scan_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "수집기 응답 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "mcpshield-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"mcpshield\"}",
          "legendFormat": "collector (1=응답, 0=실패)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
